{
  "name": "tathva-tshirt",
  "version": "1.0.0",
  "private": true,
  "description": "Tathva T-Shirt Distribution - LAN-only event operations tool",
  "type": "commonjs",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "dev:tools": "DEV_TOOLS=1 node --watch server/src/index.js",
    "setup": "bash scripts/setup-db.sh",
    "migrate": "node server/src/migrate.js",
    "test": "node scripts/run-tests.js",
    "import": "node scripts/import-csv.js",
    "backup": "bash scripts/backup.sh",
    "sample-data": "node scripts/make-sample-data.js",
    "qr-portal": "node qr-portal/serve.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  }
}
