# Copy to .env and adjust for the event laptop.
# On macOS/Homebrew Postgres the default superuser is your OS username with no password.
DATABASE_URL=postgresql://localhost:5432/tathva_tshirt
PORT=3000
HTTPS_PORT=3443
HOST=0.0.0.0
# Test database used by `npm test` (it is wiped on every run).
TEST_DATABASE_URL=postgresql://localhost:5432/tathva_tshirt_test
# Set to 1 to serve the development-only QR generator and test scanner at /dev.
# Leave unset/0 on the event laptop.
DEV_TOOLS=0
